@using System.Globalization
@using Microsoft.Extensions.Configuration
@using Radzen
@using Radzen.Blazor
@using Senti.Shared.Models
@using Senti.Shared.Models.Quotes
@using System.Text.Json

@inject IConfiguration Configuration

@page "/correlation-4"

<div>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Left" Gap="2rem" class="rz-p-sm-12">
        <RadzenLabel Text="Select stock" Component="DropDownEnums" />
        <RadzenDropDown 
        TValue="string"
        Data="@(stocks)" 
        Value="@stock"
        Change="@(async x => await OnStockChange(x))"

        AllowFiltering="true" 
        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" 
        Style="width: 100%; max-width: 400px;" 
        Name="Stock">
        </RadzenDropDown>

        <RadzenLabel Text="Start" Component="RadzenDatePickerBindValue" />
        <RadzenDatePicker 
        TValue="DateTime"
        Change="@(async x => await OnDateChangeStart(x))" 
        Value="@(_from)"
        Name="RadzenDatePickerBindValue" 
        ShowCalendarWeek />
        <RadzenLabel Text="End" Component="RadzenDatePickerBindValue" />
        <RadzenDatePicker 
        TValue="DateTime"
        Change="@(async x => await OnDateChangeEnd(x))" 
        Value="@(_to)"
        Name="RadzenDatePickerBindValue" 
        ShowCalendarWeek />

    </RadzenStack>



    <RadzenStack class="rz-p-0 rz-p-md-6 rz-p-lg-12">
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenCheckBox @bind-Value="@annotation" Name="annotation"></RadzenCheckBox>
                <RadzenLabel Text="Annotation" Component="annotation" />
            </RadzenStack>
        </RadzenCard>

        <RadzenChart>
            <RadzenLineSeries Smooth="true" Data="@_data" CategoryProperty="t" Title="2024" ValueProperty="c" RenderingOrder="1">
                <RadzenSeriesAnnotation Visible="@annotation" TItem="RawQuote" Data="@_data[0]" OffsetY="-16" Text="Acquisition" />
                <RadzenSeriesAnnotation Visible="@annotation" TItem="RawQuote" Data="@_data[1]" OffsetY="-16" Text="IPO" Fill="#ff504d" />
                <RadzenMarkers MarkerType="MarkerType.Triangle" />
            </RadzenLineSeries>
            <RadzenCategoryAxis Padding="20" />
            <RadzenValueAxis Formatter="@FormatAsUSD">
                <RadzenGridLines Visible="true" />
                <RadzenAxisTitle Text="Revenue in USD" />
            </RadzenValueAxis>
        </RadzenChart>
    </RadzenStack>

</div>

@code {
    private string _getQuotesUrl;
    private string _stock = "AAPL";
    private DateTimeOffset _from = new DateTime(2025, 01, 05, 0, 0, 0, kind: DateTimeKind.Utc);
    private DateTimeOffset _to = new DateTime(2025, 02, 05, 0, 0, 0, kind: DateTimeKind.Utc);

    Radzen.DataGridGridLines GridLines = Radzen.DataGridGridLines.Default;
    string stock = "AAPL";
    List<string> stocks = new List<string> { "AAPL", "MSFT", "GOOGL", "NVDA", "AMZN", "TSLA", "MCD" };
    List<RawQuote> quotes = new List<RawQuote>();

    bool annotation = true;

    public async Task OnStockChange(object args)
    {
        stock = args.ToString();
        //var url = Configuration[Envars.Senti_GetQuotesUrl];
        //url = url.Replace("{{stock}}", stock);
        var response = await new HttpClient().GetStreamAsync(_getQuotesUrl);

        var options = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            };

        var result = JsonSerializer.Deserialize<List<RawQuote>>(response, options);
        quotes = result
        .OrderByDescending(x => x.t)
        .ToList();
    }

    public async Task OnDateChangeStart(object args)
    {
        _from = (args as DateTime?) ?? 
            new DateTime(2025, 02, 05, 0, 0, 0, kind: DateTimeKind.Utc);

        //SetChartData();
        //SetNewsData();
        //await Task.Delay(500);
        //await _chart.NewPlot();
    }

    public async Task OnDateChangeEnd(object args)
    {
        _to = (args as DateTime?) ?? 
            new DateTime(2025, 02, 05, 0, 0, 0, kind: DateTimeKind.Utc);

        await Change();

        //SetChartData();
        //SetNewsData();
        //await Task.Delay(500);
        //await _chart.NewPlot();
    }

    private async Task Change()
    {
        _getQuotesUrl = _getQuotesUrl.Replace("{{stock}}", stock);
        _getQuotesUrl = _getQuotesUrl.Replace("{{from}}", _from.ToUnixTimeMilliseconds().ToString());
        _getQuotesUrl = _getQuotesUrl.Replace("{{to}}", _to.ToUnixTimeMilliseconds().ToString());

        var response = await new HttpClient().GetStreamAsync(_getQuotesUrl);

        var options = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            };

        var result = JsonSerializer.Deserialize<List<RawQuote>>(response, options);
        _data = result
        .OrderByDescending(x => x.t)
        .ToArray();


        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        _getQuotesUrl = Configuration[Envars.Senti_GetQuotesUrl];
        await base.OnInitializedAsync();
        //await OnStockChange(stock);
    }

























