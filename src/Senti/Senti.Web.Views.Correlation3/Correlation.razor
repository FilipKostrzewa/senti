@using System.Globalization
@using ApexCharts
@using Microsoft.Extensions.Configuration
@using Radzen
@using Radzen.Blazor
@using Senti.Shared.Models
@using Senti.Shared.Models.News
@using Senti.Shared.Models.Quotes
@using System.Text.Json

@inject IConfiguration Configuration

@page "/"

<RadzenLabel Text="Select stock" Component="DropDownEnums" />

<RadzenDropDown 
TValue="string"
Data="@(stocks)" 
Value="@stock"
Change="@(async x => await OnStockChange(x))"
AllowFiltering="true" 
FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" 
Name="Stock" />

<RadzenButton Click=@(async x => await OnChangeDay(-1)) Text="Prev Day" ButtonStyle="ButtonStyle.Info"  Style="margin-left:20px"/>

<RadzenDatePicker 
TValue="DateTime"
Change="@(async x => await OnDateChangeStart(x))" 
Value="@(_from)"
Name="RadzenDatePickerBindValue"  Style="margin-left:20px"
ShowCalendarWeek />

<RadzenButton Click=@(async x => await OnChangeDay(1)) Text="Next Day" ButtonStyle="ButtonStyle.Info"  Style="margin-left:20px"/>

<RadzenLabel Text="Candles: " Component="RadzenDatePickerBindValue" Style="margin-left:20px"/>
<RadzenButton Click=@(async x => await OnChangeTicks(6)) Text="6h" ButtonStyle="@but6" />
<RadzenButton Click=@(async x => await OnChangeTicks(12)) Text="12h" ButtonStyle="@but12" />
<RadzenButton Click=@(async x => await OnChangeTicks(36)) Text="36h" ButtonStyle="@but36" />
<RadzenButton Click=@(async x => await OnChangeTicks(60)) Text="60h" ButtonStyle="@but60" />
<RadzenButton Click=@(async x => await OnChangeTicks(84)) Text="84h" ButtonStyle="@but84" />


@* <RadzenLabel Text="End " Component="RadzenDatePickerBindValue" Style="margin-left:10px" />
<RadzenDatePicker 
TValue="DateTime"
Change="@(async x => await OnDateChangeEnd(x))" 
Value="@(_to)"
Name="RadzenDatePickerBindValue" 
ShowCalendarWeek />
 *@



<ApexChart @ref="_quoteChartRef" Height="500"
TItem="QuoteMini"
Title=""
Options="_options"
>


    <ApexCandleSeries
    Name="Price"
    TItem="QuoteMini" 
    Items="_quoteData"
    Open="e => 1m *e.o/100"
    Close="e => 1m *e.c/100"
    High="e => 1m*e.h/100"
    Low="e => 1m*e.l/100"
    XValue="e => e.t" />

    <ApexCandleSeries
    Color="grey"


    Name="Forecast"
    TItem="QuoteMini" 
    Items="_quoteData"
    Open="e => 1m *e.o/99"
    Close="e => 1m *e.c/99"
    High="e => 1m*e.h/99"
    Low="e => 1m*e.l/99"
    XValue="e => e.t" />

</ApexChart>

<ApexChart @ref="_newsChartRef" Height="500" TItem="ArticleMini" 
Title="Sentiment" 
Options="_newsOptions"
>

    <ApexPointSeries TItem="ArticleMini"
    Items="_newsData"
    Name="Positive Sentiment"
    SeriesType="SeriesType.Area"
    XValue="e => e.Published"
    YValue="e => (decimal)e.SentimentPositive"
    Color="green"
    ShowDataLabels />

    <ApexPointSeries TItem="ArticleMini"
    Items="_newsData"
    Name="Negative Sentiment"
    SeriesType="SeriesType.Area"
    XValue="e => e.Published"
    YValue="e => (decimal)e.SentimentNegative * (-1)"
    Color="red"
    ShowDataLabels />


</ApexChart>

<RadzenLabel Text="Positive Sentiment Correlation" />
<RadzenTextBox @bind-Value="@corrPositive" />
<RadzenLabel Text="Negative Sentiment Correlation" />
<RadzenTextBox @bind-Value="@corrNegative" />

<RadzenDataGrid 
Data="@_newsData" 
GridLines="@GridLines" 
AllowPaging="true" 
AllowSorting="true"

AllowColumnResize="true">

    <Columns>
        <RadzenDataGridColumn Width="200px" Property="Published" Title="Publish Date" />
        <RadzenDataGridColumn Property="Title" Title="Title" />
        <RadzenDataGridColumn Width="100px" Property="SentimentPositive" Title="Positive" />
        <RadzenDataGridColumn Width="100px" Property="SentimentNeutral" Title="Neutral" />
        <RadzenDataGridColumn Width="100px" Property="SentimentNegative" Title="Negative" />
    </Columns>
</RadzenDataGrid>



@code {
    string corrPositive = string.Empty;
    string corrNegative = string.Empty;

    Radzen.DataGridGridLines GridLines = Radzen.DataGridGridLines.Default;

    ButtonStyle but6 = ButtonStyle.Info;
    ButtonStyle but12 = ButtonStyle.Info;
    ButtonStyle but36 = ButtonStyle.Info;
    ButtonStyle but60 = ButtonStyle.Info;
    ButtonStyle but84 = ButtonStyle.Info;

    private ApexChart<QuoteMini> _quoteChartRef;
    private ApexChart<ArticleMini> _newsChartRef;
    private ApexChartOptions<QuoteMini> _options = new ApexChartOptions<QuoteMini>
    {

        DataLabels = new DataLabels
        {
            Formatter = @"function(value)
            {
                return `$ ${(value).toFixed(2)}`
            }",

        },

        Xaxis = new XAxis
        {
            Title = new AxisTitle
            {
                Text = "Time",
            },
            Labels = new XAxisLabels
            {
                Formatter = @"function(value)
                {
                    const date = new Date(value * 1000);
                    const day = date.getDate();
                    const month = date.toLocaleString('en-US', { month: 'short' });
                    const hours = date.getHours().toString().padStart(2, '0');
                    const minutes = date.getMinutes().toString().padStart(2, '0');
                    return `${day} ${month} ${hours}:${minutes}`;
                }",
            },
        },
        Yaxis = new List<YAxis>
        {
            new YAxis
            {
                Title = new AxisTitle{ Text = "Price" },
                Labels = new YAxisLabels
                {
                    Formatter = @"function(value)
                    {
                        return `$ ${(value).toFixed(2)}`
                    }",
                },
            },
        },
        Tooltip = new ApexCharts.Tooltip
        {
            Y = new TooltipY
            {
                Formatter = @"function(value)
                {
                    return `$ ${(value).toFixed(2)}`
                }",
            }
        }

    };
    private ApexChartOptions<ArticleMini> _newsOptions = new ApexChartOptions<ArticleMini>
    {
        Colors = new List<string>
        {
          "blue", "green" , "grey" 
        },

        DataLabels = new DataLabels
        {
            Formatter = @"function(value)
            {
                return `$ ${(value).toFixed(2)}`
            }",

        },

        Xaxis = new XAxis
        {
            Title = new AxisTitle
            {
                Text = "Time",
            },
            Labels = new XAxisLabels
            {
                Formatter = @"function(value)
                {
                    const date = new Date(value * 1000);
                    const day = date.getDate();
                    const month = date.toLocaleString('en-US', { month: 'short' });
                    const hours = date.getHours().toString().padStart(2, '0');
                    const minutes = date.getMinutes().toString().padStart(2, '0');
                    return `${day} ${month} ${hours}:${minutes}`;
                }",
            },
        },
        Yaxis = new List<YAxis>
        {
            new YAxis
            {
                Title = new AxisTitle{ Text = "Sentiment" },
                Labels = new YAxisLabels
                {
                    Formatter = @"function(value)
                    {
                        return `${(value).toFixed(2)}`
                    }",
                },
            },
        },
        Tooltip = new ApexCharts.Tooltip
        {
            Y = new TooltipY
            {
                Formatter = @"function(value)
                {
                    return `${(value).toFixed(2)}`
                }",
            }
        }

    };


    private int _hours = 12;
    private List<string> stocks = new List<string> { "AAPL", "MSFT", "GOOGL", "NVDA", "AMZN", "TSLA", "MCD" };
    private DateTimeOffset _from = new DateTime(2025, 02, 18, 9, 0, 0, kind: DateTimeKind.Utc);
    private QuoteMini[] _quoteData = [];
    private ArticleMini[] _newsData = [];




    //Radzen.DataGridGridLines GridLines = Radzen.DataGridGridLines.Default;
    string stock = "AAPL";

    bool annotation = true;

    public async Task OnStockChange(object args)
    {
        stock = args as string ?? "AAPL";
        await Change();
    }

    public async Task OnChangeDay(int days)
    {
        _from = _from.AddDays(days);
        await Change();
    }

    public async Task OnChangeTicks(int hours)
    {
        but6 = ButtonStyle.Info;
        but12 = ButtonStyle.Info;
        but36 = ButtonStyle.Info;
        but60 = ButtonStyle.Info;
        but84 = ButtonStyle.Info;
        var but = hours switch
        {
            6 => but6,
            12 => but12,
            36 => but36,
            60 => but60,
            84 => but84,
        };
        but = ButtonStyle.Danger;

        _hours = hours;
        await Change();
    }

    public async Task OnDateChangeStart(object args)
    {
        _from = (args as DateTime?) ?? new DateTime(2025, 02, 18, 9, 0, 0, kind: DateTimeKind.Utc);
        await Change();
    }

    private async Task Change()
    {
        var quoteTask = ChangeQuotes();
        var newsTask = ChangeNews();

        await Task.WhenAll([quoteTask, newsTask]);

        var sentimentPositive = _newsData.Select(x => x.SentimentPositive).ToArray();
        double[] sentimentNegative = _newsData.Select(x => x.SentimentNegative).ToArray();
        int[] close = _quoteData.Select(x => x.c).ToArray();
        corrPositive = $"{CorrelationCalculator.Calculate(close, sentimentPositive)}";
        corrNegative = $"{CorrelationCalculator.Calculate(close, sentimentNegative)}";

        await _quoteChartRef.UpdateSeriesAsync(false);
        StateHasChanged();
        await _quoteChartRef.UpdateSeriesAsync(false);
        StateHasChanged();
        await _newsChartRef.UpdateSeriesAsync(false);
        StateHasChanged();
        await _newsChartRef.UpdateSeriesAsync(false);
        StateHasChanged();
    }

    private async Task ChangeQuotes()
    {
        var from = _from.ToUnixTimeSeconds();
        var to = from + (_hours * 60 * 60) + 13;

        var getQuotesUrl = Configuration[Envars.Senti_GetQuotesUrl];
        getQuotesUrl = getQuotesUrl.Replace("{{stock}}", stock);
        getQuotesUrl = getQuotesUrl.Replace("{{from}}", from.ToString());
        getQuotesUrl = getQuotesUrl.Replace("{{to}}", to.ToString());

        var getNewsUrl = Configuration[Envars.Senti_GetNewsUrl];
        getNewsUrl = getNewsUrl.Replace("{{stock}}", stock);
        getNewsUrl = getNewsUrl.Replace("{{from}}", from.ToString());
        getNewsUrl = getNewsUrl.Replace("{{to}}", to.ToString());

        var response = await new HttpClient().GetStreamAsync(getQuotesUrl);
        var options = new JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true
        };

        var result = await JsonSerializer.DeserializeAsync<QuoteMini[]>(response, options);

        _quoteData = result
            .OrderBy(x => x.t)
            .Take(_hours * 12)
            .ToArray();
    }

    private async Task ChangeNews()
    {
        var from = _from.ToUnixTimeSeconds();
        var to = from + (_hours * 60 * 60) + 13;

        var getNewsUrl = Configuration[Envars.Senti_GetNewsUrl];
        getNewsUrl = getNewsUrl.Replace("{{stock}}", stock);
        getNewsUrl = getNewsUrl.Replace("{{from}}", from.ToString());
        getNewsUrl = getNewsUrl.Replace("{{to}}", to.ToString());

        var response = await new HttpClient().GetStreamAsync(getNewsUrl);
        var options = new JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true
        };

        var result = await JsonSerializer.DeserializeAsync<ArticleMini[]>(response, options);

        _newsData = result
            .OrderBy(x => x.Published)
            .ToArray();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        //await Task.Delay(5000);
        await Change();
        await Change();
    }

}