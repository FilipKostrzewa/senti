@using System.Text.Json

@inject IConfiguration Configuration

@page "/correlation-3"

<div>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Left" Gap="2rem" class="rz-p-sm-12">
        <RadzenLabel Text="Select stock" Component="DropDownEnums" />
        <RadzenDropDown 
        TValue="string"
        Data="@(stocks)" 
        Value="@stock"
        Change="@(async x => await OnStockChange(x))"

        AllowFiltering="true" 
        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" 
        Style="width: 100%; max-width: 400px;" 
        Name="Stock">
        </RadzenDropDown>

        <RadzenLabel Text="Start" Component="RadzenDatePickerBindValue" />
        <RadzenDatePicker 
        TValue="DateTime"
        Change="@(async x => await OnDateChangeStart(x))" 
        Value="@(_from)"
        Name="RadzenDatePickerBindValue" 
        ShowCalendarWeek />
        <RadzenLabel Text="End" Component="RadzenDatePickerBindValue" />
        <RadzenDatePicker 
        TValue="DateTime"
        Change="@(async x => await OnDateChangeEnd(x))" 
        Value="@(_to)"
        Name="RadzenDatePickerBindValue" 
        ShowCalendarWeek />

    </RadzenStack>



    <RadzenStack class="rz-p-0 rz-p-md-6 rz-p-lg-12">

        <canvas id="candlestickChart" width="1600" height="400"></canvas>
        <script>
            const canvas = document.getElementById("candlestickChart");
            const ctx = canvas.getContext("2d");

            const candleCount = 100;
            const candleWidth = 20;
            const candleSpacing = 10;
            const baseY = 300;

            function getRandomPrice(base) {
                let open = base + Math.random() * 50 - 25;
                let close = base + Math.random() * 50 - 25;
                let high = Math.max(open, close) + Math.random() * 20;
                let low = Math.min(open, close) - Math.random() * 20;
                return { open, close, high, low };
            }

            function drawCandlestick(x, { open, close, high, low }) {
                let color = close >= open ? "green" : "red";
                ctx.strokeStyle = "black";
                ctx.beginPath();
                ctx.moveTo(x + candleWidth / 2, baseY - high);
                ctx.lineTo(x + candleWidth / 2, baseY - low);
                ctx.stroke();

                ctx.fillStyle = color;
                ctx.fillRect(x, baseY - Math.max(open, close), candleWidth, Math.abs(open - close));
                ctx.strokeRect(x, baseY - Math.max(open, close), candleWidth, Math.abs(open - close));
            }

            function drawChart() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                let basePrice = 200;
                for (let i = 0; i < candleCount; i++) {
                    let x = i * (candleWidth + candleSpacing) + 20;
                    let prices = getRandomPrice(basePrice);
                    drawCandlestick(x, prices);
                    basePrice = prices.close;
                }
            }

            drawChart();
        </script>
    </RadzenStack>

</div>

