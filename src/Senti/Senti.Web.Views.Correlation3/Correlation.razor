@using System.Globalization
@using ApexCharts
@using Microsoft.Extensions.Configuration
@using Radzen
@using Radzen.Blazor
@using Senti.Shared.Models
@using Senti.Shared.Models.Quotes
@using System.Text.Json

@inject IConfiguration Configuration

@page "/"

<RadzenLabel Text="Select stock" Component="DropDownEnums" />

<RadzenDropDown 
TValue="string"
Data="@(stocks)" 
Value="@stock"
Change="@(async x => await OnStockChange(x))"
AllowFiltering="true" 
FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" 
Name="Stock" />

<RadzenButton Click=@(async x => await OnChangeDay(-1)) Text="Prev Day" ButtonStyle="ButtonStyle.Info"  Style="margin-left:20px"/>

<RadzenDatePicker 
TValue="DateTime"
Change="@(async x => await OnDateChangeStart(x))" 
Value="@(_from)"
Name="RadzenDatePickerBindValue"  Style="margin-left:20px"
ShowCalendarWeek />

<RadzenButton Click=@(async x => await OnChangeDay(1)) Text="Next Day" ButtonStyle="ButtonStyle.Info"  Style="margin-left:20px"/>

<RadzenLabel Text="Candles: " Component="RadzenDatePickerBindValue" Style="margin-left:20px"/>
<RadzenButton Click=@(async x => await OnChangeTicks(6)) Text="6h" ButtonStyle="@but6" />
<RadzenButton Click=@(async x => await OnChangeTicks(12)) Text="12h" ButtonStyle="@but12" />
<RadzenButton Click=@(async x => await OnChangeTicks(36)) Text="36h" ButtonStyle="@but36" />
<RadzenButton Click=@(async x => await OnChangeTicks(60)) Text="60h" ButtonStyle="@but60" />
<RadzenButton Click=@(async x => await OnChangeTicks(84)) Text="84h" ButtonStyle="@but84" />


@* <RadzenLabel Text="End " Component="RadzenDatePickerBindValue" Style="margin-left:10px" />
<RadzenDatePicker 
TValue="DateTime"
Change="@(async x => await OnDateChangeEnd(x))" 
Value="@(_to)"
Name="RadzenDatePickerBindValue" 
ShowCalendarWeek />
 *@



<ApexChart @ref = "_chartRef" Height="500"
TItem="QuoteMini"
Title=""
Options="_options"
>

    <ApexCandleSeries
    Name="Price"
    TItem="QuoteMini" 
    Items="_data"
    Open="e => 1m *e.o/100"
    Close="e => 1m *e.c/100"
    High="e => 1m*e.h/100"
    Low="e => 1m*e.l/100"
    XValue="e => e.t"

    />

</ApexChart>



@code {
    ButtonStyle but6 = ButtonStyle.Info;
    ButtonStyle but12 = ButtonStyle.Info;
    ButtonStyle but36 = ButtonStyle.Info;
    ButtonStyle but60 = ButtonStyle.Info;
    ButtonStyle but84 = ButtonStyle.Info;

    private string _getQuotesUrl = string.Empty;
    private ApexChart<QuoteMini> _chartRef;
    private ApexChartOptions<QuoteMini> _options = new ApexChartOptions<QuoteMini>
    {

        DataLabels = new DataLabels
        {
            Formatter = @"function(value)
            {
                return `$ ${(value).toFixed(2)}`
            }",

        },

        Xaxis = new XAxis
        {
            Title = new AxisTitle
            {
                Text = "Time",
            },
            Labels = new XAxisLabels
            {
                Formatter = @"function(value)
                {
                    const date = new Date(value * 1000);
                    const day = date.getDate();
                    const month = date.toLocaleString('en-US', { month: 'short' });
                    const hours = date.getHours().toString().padStart(2, '0');
                    const minutes = date.getMinutes().toString().padStart(2, '0');
                    return `${day} ${month} ${hours}:${minutes}`;
                }",
            },
        },
        Yaxis = new List<YAxis>
        {
            new YAxis
            {
                Title = new AxisTitle{ Text = "Price" },
                Labels = new YAxisLabels
                {
                    Formatter = @"function(value)
                    {
                        return `$ ${(value).toFixed(2)}`
                    }",
                },
            },
        },
        Tooltip = new ApexCharts.Tooltip
        {
            Y = new TooltipY
            {
                Formatter = @"function(value)
                {
                    return `$ ${(value).toFixed(2)}`
                }",
            }
        }

    };


    private int _hours = 12;
    private List<string> stocks = new List<string> { "AAPL", "MSFT", "GOOGL", "NVDA", "AMZN", "TSLA", "MCD" };
    private DateTimeOffset _from = new DateTime(2025, 01, 06, 9, 0, 0, kind: DateTimeKind.Utc);
    private QuoteMini[] _data = [];




    //Radzen.DataGridGridLines GridLines = Radzen.DataGridGridLines.Default;
    string stock = "AAPL";

    bool annotation = true;

    public async Task OnStockChange(object args)
    {
        stock = args as string ?? "AAPL";
        await Change();
    }

    public async Task OnChangeDay(int days)
    {
        _from = _from.AddDays(days);
        await Change();
    }

    public async Task OnChangeTicks(int hours)
    {
        but6 = ButtonStyle.Info;
        but12 = ButtonStyle.Info;
        but36 = ButtonStyle.Info;
        but60 = ButtonStyle.Info;
        but84 = ButtonStyle.Info;
        var but = hours switch
        {
            6 => but6,
            12 => but12,
            36 => but36,
            60 => but60,
            84 => but84,
        };
        but = ButtonStyle.Danger;

        _hours = hours;
        await Change();
    }

    public async Task OnDateChangeStart(object args)
    {
        _from = (args as DateTime?) ?? new DateTime(2025, 01, 06, 9, 0, 0, kind: DateTimeKind.Utc);
        await Change();
    }

    private async Task Change()
    {
        var from = _from.ToUnixTimeSeconds();
        var to = from + (_hours * 60 * 60) + 13;
        _getQuotesUrl = Configuration[Envars.Senti_GetQuotesUrl];
        _getQuotesUrl = _getQuotesUrl.Replace("{{stock}}", stock);
        _getQuotesUrl = _getQuotesUrl.Replace("{{from}}", from.ToString());
        _getQuotesUrl = _getQuotesUrl.Replace("{{to}}", to.ToString());

        var response = await new HttpClient().GetStreamAsync(_getQuotesUrl);
        var options = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            };

        var result = await JsonSerializer.DeserializeAsync<QuoteMini[]>(response, options);

        _data = result
            .OrderBy(x => x.t)
            .Take(_hours * 12)
            .ToArray();

        await _chartRef.UpdateSeriesAsync(false);
        StateHasChanged();
        await _chartRef.UpdateSeriesAsync(false);
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        //await Task.Delay(5000);
        await Change();
        await Change();
    }

}