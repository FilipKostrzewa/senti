@using Microsoft.JSInterop
@using Senti.Shared.Models.Quotes
@using System.Text.Json
@inherits ComponentBase
@inject IJSRuntime JsRuntime

@code {
    [Parameter] public required QuoteMini[] Quotes { get; set; }
    public ElementReference redrawButtonRef;

    public async Task Redraw()
    {
        await JsRuntime.InvokeVoidAsync("ClickButton", redrawButtonRef);
    }
}

<div style="width: 100%;">
    <canvas id="candlestickChart"></canvas>
</div>

<script>
    function ClickButton(element) {
        if (element) {
            element.click();
        }
    }

    function drawCandlestick(ctx, x, candleWidth, scaleY, yOffset, { open, close, high, low }) {
        const candleX = x;
        const candleColor = close >= open ? "green" : "red";

        const highY = yOffset - high * scaleY;
        const lowY = yOffset - low * scaleY;
        const openY = yOffset - open * scaleY;
        const closeY = yOffset - close * scaleY;

        ctx.strokeStyle = "grey";
        ctx.beginPath();
        ctx.moveTo(candleX + candleWidth / 2, highY);
        ctx.lineTo(candleX + candleWidth / 2, lowY);
        ctx.stroke();

        ctx.fillStyle = candleColor;
        const rectY = Math.min(openY, closeY);
        const rectHeight = Math.abs(openY - closeY);
        ctx.fillRect(candleX, rectY, candleWidth, rectHeight);
        ctx.strokeRect(candleX, rectY, candleWidth, rectHeight);
    }

    function drawChart() {
        const hiddenElement = document.getElementById("quotesid");
        const jsonData = hiddenElement.textContent.trim();
        const arr = JSON.parse(jsonData);
        const canvas = document.getElementById("candlestickChart");
        const ctx = canvas.getContext("2d");

        // Fit canvas to parent width
        const parent = canvas.parentElement;
        canvas.width = parent.clientWidth;
        canvas.height = 400;

        const width = canvas.width;
        const height = canvas.height;

        // Get price range
        let minPrice = Math.min(...arr.map(x => x.l));
        let maxPrice = Math.max(...arr.map(x => x.h));
        let priceRange = maxPrice - minPrice;

        const yPadding = 20;
        const scaleY = (height - yPadding * 2) / priceRange;
        const yOffset = height - yPadding + minPrice * scaleY;

        // Candle layout
        const candleCount = arr.length;
        const candleSpacing = 4;
        const totalSpacing = (candleCount - 1) * candleSpacing;
        const candleWidth = Math.max((width - totalSpacing) / candleCount, 1);

        ctx.clearRect(0, 0, width, height);

        for (let i = 0; i < candleCount; i++) {
            const q = arr[i];
            const x = i * (candleWidth + candleSpacing) + 1;
            drawCandlestick(ctx, x, candleWidth, scaleY, yOffset, {
                open: q.o,
                close: q.c,
                high: q.h,
                low: q.l
            });
        }
    }

    window.addEventListener('resize', () => {
        drawChart();
    });
</script>

<input @ref="redrawButtonRef" id="redrawButton" type="button" value="clickme" onclick="drawChart();" hidden />
<div id="quotesid" hidden>@(JsonSerializer.Serialize(Quotes))</div>
