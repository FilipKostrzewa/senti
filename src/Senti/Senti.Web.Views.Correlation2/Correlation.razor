@using System.Globalization
@using ApexCharts
@using Microsoft.Extensions.Configuration
@using Radzen
@using Radzen.Blazor
@using Senti.Shared.Models
@using Senti.Shared.Models.Quotes
@using System.Text.Json

@inject IConfiguration Configuration

@page "/"

<RadzenLabel Text="Select stock" Component="DropDownEnums" />

<RadzenDropDown 
TValue="string"
Data="@(stocks)" 
Value="@stock"
Change="@(async x => await OnStockChange(x))"
AllowFiltering="true" 
FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" 
Style="width: 100%; max-width: 400px;" 
Name="Stock" />

<RadzenLabel Text="Start " Component="RadzenDatePickerBindValue" Style="margin-left:10px"/>
<RadzenDatePicker 
TValue="DateTime"
Change="@(async x => await OnDateChangeStart(x))" 
Value="@(_from)"
Name="RadzenDatePickerBindValue" 
ShowCalendarWeek />

<RadzenLabel Text="End " Component="RadzenDatePickerBindValue" Style="margin-left:10px" />
<RadzenDatePicker 
TValue="DateTime"
Change="@(async x => await OnDateChangeEnd(x))" 
Value="@(_to)"
Name="RadzenDatePickerBindValue" 
ShowCalendarWeek />




<ApexChart @ref = "_chartRef" Height="500"
TItem="QuoteMini"
Title=""
Options="_options"
>

    <ApexCandleSeries
    Name="Price"
    TItem="QuoteMini" 
    Items="_data"
    Open="e => 1m *e.o/100"
    Close="e => 1m *e.c/100"
    High="e => 1m*e.h/100"
    Low="e => 1m*e.l/100"
    XValue="e => e.t"

    />

</ApexChart>



@code {
    private string _getQuotesUrl = string.Empty;
    private ApexChart<QuoteMini> _chartRef;
    private ApexChartOptions<QuoteMini> _options = new ApexChartOptions<QuoteMini>
    {

        DataLabels = new DataLabels
        {
            Formatter = @"function(value)
            {
                return `$ ${(value).toFixed(2)}`
            }",
            
        },

        Xaxis = new XAxis
        {
            Title = new AxisTitle
            {
                Text = "Time",
            },
            Labels = new XAxisLabels
            {
                Formatter = @"function(value)
                {
                    const date = new Date(value * 1000);
                    const day = date.getDate();
                    const month = date.toLocaleString('en-US', { month: 'short' });
                    const hours = date.getHours().toString().padStart(2, '0');
                    const minutes = date.getMinutes().toString().padStart(2, '0');
                    return `${day} ${month} ${hours}:${minutes}`;
                }",
            },
        },
        Yaxis = new List<YAxis>
        {
            new YAxis
            {
                Title = new AxisTitle{ Text = "Price" },
                Labels = new YAxisLabels
                {
                    Formatter = @"function(value)
                    {
                        return `$ ${(value).toFixed(2)}`
                    }",
                },
            },
        },
        Tooltip = new ApexCharts.Tooltip
        {
            Y = new TooltipY
            {
                Formatter = @"function(value)
                {
                    return `$ ${(value).toFixed(2)}`
                }",
            }
        }

    };

    List<string> stocks = new List<string> { "AAPL", "MSFT", "GOOGL", "NVDA", "AMZN", "TSLA", "MCD" };
    private DateTimeOffset _from = new DateTime(2025, 01, 05, 0, 0, 0, kind: DateTimeKind.Utc);
    private DateTimeOffset _to = new DateTime(2025, 01, 10, 0, 0, 0, kind: DateTimeKind.Utc);
    private QuoteMini[] _data = [];




    //Radzen.DataGridGridLines GridLines = Radzen.DataGridGridLines.Default;
    string stock = "AAPL";

    bool annotation = true;

    public async Task OnStockChange(object args)
    {
        stock = args as string ?? "AAPL";
        await Change();
    }

    public async Task OnDateChangeStart(object args)
    {
        _from = (args as DateTime?) ?? new DateTime(2025, 01, 01, 0, 0, 0, kind: DateTimeKind.Utc);
        await Change();
    }

    public async Task OnDateChangeEnd(object args)
    {
        _to = (args as DateTime?) ?? new DateTime(2025, 01, 05, 0, 0, 0, kind: DateTimeKind.Utc);
        await Change();
    }

    private async Task Change()
    {
        _getQuotesUrl = Configuration[Envars.Senti_GetQuotesUrl];
        _getQuotesUrl = _getQuotesUrl.Replace("{{stock}}", stock);
        _getQuotesUrl = _getQuotesUrl.Replace("{{from}}", _from.ToUnixTimeSeconds().ToString());
        _getQuotesUrl = _getQuotesUrl.Replace("{{to}}", _to.ToUnixTimeSeconds().ToString());

        var response = await new HttpClient().GetStreamAsync(_getQuotesUrl);
        var options = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            };

        var result = await JsonSerializer.DeserializeAsync<QuoteMini[]>(response, options);

        _data = result
            .OrderBy(x => x.t)
            .Take(200)
            .ToArray();

        await _chartRef.UpdateSeriesAsync(false);
        StateHasChanged();
        await _chartRef.UpdateSeriesAsync(false);
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        //await Task.Delay(5000);
        await Change();
        await Change();
    }

}